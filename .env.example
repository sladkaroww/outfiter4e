# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Object Storage (bucket + S3 credentials from `neon env pull`)
NEON_STORAGE_BUCKET=wardrobe-images
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override; defaults to gemini-flash-lite-latest
GEMINI_MODEL=

# Site URL used for canonical links, sitemap and OG metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional consent-gated analytics (Plausible / Umami script URL + domain)
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

